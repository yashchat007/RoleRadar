# Copy to backend/.env (never commit secrets). Loaded by app/config.py via absolute path.
DATABASE_URL=postgresql+asyncpg://roleradar:roleradar@127.0.0.1:5432/roleradar

# Optional discovery tuning (defaults shown)
# DISCOVERY_SAFETY_MAX_JOBS_PER_SCAN=300
# DISCOVERY_JPM_SAFETY_MAX_JOBS_PER_SCAN=500
# DISCOVERY_DETAIL_ENRICH_MAX_JOBS=120

# Optional alerts (not required for discover_jobs)
# ALERT_RECIPIENT_EMAIL=you@example.com
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM=briefing@roleradar.local
